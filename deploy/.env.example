# deploy/.env.example — production environment (SRV-00).
# On the VPS: copy to /home/deploybot/.env (mode 600) and fill in DOMAIN.
# There are no secrets in v1. Never commit a real .env.

# Public domain of the server; Caddy gets a TLS certificate for it.
DOMAIN=play.example.com
# debug | info | warn | error
LOG_LEVEL=info
# Comma-separated gameVersionCodes (the client's integer appVersionCode, e.g.
# 923,924) accepted at the handshake. Empty = no version gate (PROTOCOL.md §8).
# Names like 0.1.0-coop are rejected by `server -check-env` (SRV-01).
ALLOWED_VERSIONS=

# Co-op gameplay (SRV-02). Durations use Go syntax (30s, 1500ms, 4m); every
# value is checked by `server -check-env`. Empty or absent = the default shown.
# Cell mission: seconds between the prisoner's waves (MISSION_START.waveIntervalMs).
COOP_CELL_WAVE_INTERVAL=30s
# Cell hard cap at region 0 (floors 1-5).
COOP_CELL_CAP=4m
# Added to the Cell cap per region index ((depth-1)/5).
COOP_CELL_CAP_PER_REGION=15s
# Downed window (also the Cell's overtime backstop after the cap).
COOP_DOWNED_WINDOW=30s
# A mission paused (a player away) this long is aborted without penalty.
COOP_PAUSE_GRACE=90s
# Both twin door/switch presses must land inside this window.
COOP_TWIN_WINDOW=2s
# Shared boss pool = round(boss HT x this scale), while both are on the floor.
COOP_BOSS_HP_SCALE=1.8
# Downed expiry outside a mission: player_out (the only v1 mode).
COOP_DEATH_MODE=player_out
