# deploy/.env.example — production environment (SRV-00).
# On the VPS: copy to /home/deploybot/.env (mode 600) and fill in DOMAIN.
# There are no secrets in v1. Never commit a real .env.

# Public domain of the server; Caddy gets a TLS certificate for it.
DOMAIN=play.example.com
# debug | info | warn | error
LOG_LEVEL=info
# Comma-separated game versions accepted at the handshake (empty = no gate yet).
ALLOWED_VERSIONS=0.1.0-coop
