# deploy/.env.example — production environment (SRV-00).
# On the VPS: copy to /home/deploybot/.env (mode 600) and fill in DOMAIN.
# There are no secrets in v1. Never commit a real .env.

# Public domain of the server; Caddy gets a TLS certificate for it.
DOMAIN=play.example.com
# debug | info | warn | error
LOG_LEVEL=info
# Comma-separated gameVersionCodes (the client's integer appVersionCode, e.g.
# 923,924) accepted at the handshake. Empty = no version gate (PROTOCOL.md §8).
# Names like 0.1.0-coop are rejected by `server -check-env` (SRV-01).
ALLOWED_VERSIONS=
