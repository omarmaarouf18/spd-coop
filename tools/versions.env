# tools/versions.env — single source of truth for gate tool versions (WF-01).
#
# Plain KEY=value lines only: no quotes, no spaces, no shell logic, so it can
# be sourced by bash and parsed by simple regex tools (e.g. Renovate).
#
# Read by:
#   - scripts/install-tools.sh     (installs govulncheck, gitleaks, actionlint)
#   - scripts/check-versions.sh    (drift guard: server/go.mod,
#                                   server/Dockerfile, .github/workflows/*.yml)
#   - .githooks/pre-push           (the gate; exports GOTOOLCHAIN=go$GO_VERSION)
#   - .github/workflows/*.yml      (CI reads this file, never hard-codes versions)
#
# Pin rule: a release at least 14 days old.
# To bump a tool, edit only this file (plus the go.mod / Dockerfile lines the
# drift guard then reports).

# JDK for building the game (Gradle 9.5 wrapper; bytecode targets Java 11).
# CI uses exactly this major version; locally any JDK >= this one works.
JDK_VERSION=17
# go1.27.2 was released 2026-10-02.
GO_VERSION=1.27.2
# govulncheck v1.9.0 (2026-10-11) is newer than 14 days; stay on v1.8.0.
GOVULNCHECK_VERSION=v1.8.0
# gitleaks v8.30.1 was released 2026-03-21.
GITLEAKS_VERSION=v8.30.1
# actionlint v1.7.12 was released 2026-03-30.
ACTIONLINT_VERSION=v1.7.12
