#!/usr/bin/env bash
#
# .githooks/pre-push — agent push guard + scoped local gate (WF-01; ported
# from the SaaS prototype).
#
# Two entry points:
#   - git push (git passes the remote name as $1 and ref lines on stdin):
#     push guard, then the gate scoped to the pushed range.
#   - `make check` / `make ci` / `make ci-full` (no arguments): the gate
#     scoped to the working tree vs dev; a pass writes the stamp
#     `make commit` requires (scripts/gate-stamp.sh).
# Stages and scope mapping: scripts/changed-scope.sh, docs/coop/WORKFLOW.md §6.
set -euo pipefail

# Git exports GIT_DIR / GIT_WORK_TREE into hook environments; tools run below
# must see the real repository.
unset GIT_DIR GIT_WORK_TREE
cd "$(git rev-parse --show-toplevel)"

BLOCKED_PUSH="BLOCKED: agents never push; the owner merges and pushes from the main worktree"

# ---------------------------------------------------------------------------
# Agent push guard (Layer B) — runs before anything else, only for real git
# push invocations ($1 = remote name). Layer A is the per-worktree
# remote.origin.pushurl that scripts/agent-worktree.sh sets. This layer
# blocks ANY push (to any remote) from a linked worktree or an agent/* branch.
# ---------------------------------------------------------------------------
if [ "${1:-}" != "" ]; then
	case "$(git rev-parse --git-dir)" in
	*/worktrees/*)
		echo "$BLOCKED_PUSH"
		exit 1
		;;
	esac
	case "$(git rev-parse --abbrev-ref HEAD)" in
	agent/*)
		echo "$BLOCKED_PUSH"
		exit 1
		;;
	esac
fi

# ---------------------------------------------------------------------------
# Delete-only push: when EVERY ref line has an all-zero local sha, the push
# only deletes remote refs and publishes no code, so the gate is skipped.
# ---------------------------------------------------------------------------
PUSH_LINES=""
if [ "${1:-}" != "" ]; then
	PUSH_LINES=$(cat)
	REF_LINES=0
	NON_DELETE=0
	while read -r _lref lsha _rref _rsha; do
		[ -n "${_lref}${lsha}" ] || continue
		REF_LINES=$((REF_LINES + 1))
		case "$lsha" in
		*[!0]* | "") NON_DELETE=1 ;;
		esac
	done <<<"$PUSH_LINES"
	if [ "$REF_LINES" -gt 0 ] && [ "$NON_DELETE" -eq 0 ]; then
		echo "delete-only push: gate skipped"
		exit 0
	fi
fi

# ---------------------------------------------------------------------------
# Scope. The pass stamp records the tree BEFORE the scope is computed; it is
# written only if every stage passes and the tree did not change meanwhile.
# ---------------------------------------------------------------------------
STAMP_TREE=""
if [ "${1:-}" != "" ]; then
	SCOPE_OUT=$(bash scripts/changed-scope.sh --push <<<"$PUSH_LINES")
else
	STAMP_TREE=$(bash scripts/gate-stamp.sh tree)
	SCOPE_OUT=$(bash scripts/changed-scope.sh)
fi
eval "$SCOPE_OUT"
if [ "$SCOPE_MODE" = "none" ]; then
	echo "== gate: nothing changed, no checks to run =="
	exit 0
fi
echo "== gate: running checks (scope: $SCOPE_KEY) =="

GATE_T0=$EPOCHREALTIME
STAGE_NAME=""
STAGE_T0=""
stage_begin() {
	STAGE_NAME="$1"
	STAGE_T0=$EPOCHREALTIME
	echo "-- stage: $STAGE_NAME --"
}
stage_end() {
	awk -v a="$STAGE_T0" -v b="$EPOCHREALTIME" -v n="$STAGE_NAME" 'BEGIN { printf "[timing] %s %.1fs\n", n, b - a }'
}
block() {
	echo "BLOCKED: $*"
	exit 1
}

# shellcheck source=tools/versions.env
. tools/versions.env

GATE_TMP=$(mktemp -d)
trap 'rm -rf "$GATE_TMP"' EXIT

# ---------------------------------------------------------------------------
# Pinned tools (tools/versions.env via scripts/install-tools.sh): only the
# ones this scope needs.
# ---------------------------------------------------------------------------
NEED_TOOLS="gitleaks"
if [ "$SCOPE_SERVER" = 1 ] && [ -f server/go.mod ]; then
	NEED_TOOLS="$NEED_TOOLS govulncheck"
fi
if [ "$SCOPE_ACTIONS" = 1 ]; then
	NEED_TOOLS="$NEED_TOOLS actionlint"
fi
stage_begin install-tools
# shellcheck disable=SC2086 # word splitting is intended (tool names)
TOOLS_OUT=$(bash scripts/install-tools.sh $NEED_TOOLS) ||
	block "scripts/install-tools.sh could not install the pinned gate tools (see tools/versions.env)"
tool_bin() {
	local bin
	bin=$(printf '%s\n' "$TOOLS_OUT" | sed -n "s/^$1_BIN=//p")
	[ -x "$bin" ] || { echo "BLOCKED: scripts/install-tools.sh did not report an executable for $1" >&2; exit 1; }
	printf '%s' "$bin"
}
GITLEAKS_BIN=$(tool_bin GITLEAKS)
echo "gitleaks: $GITLEAKS_BIN"
stage_end

# ---------------------------------------------------------------------------
# secrets: gitleaks over the change only — the pushed range on a real push,
# otherwise merge-base(dev)..HEAD plus staged, unstaged and untracked files.
# ---------------------------------------------------------------------------
stage_begin secrets
if [ "${1:-}" != "" ]; then
	while read -r _lref lsha _rref rsha; do
		[ -n "${_lref}${lsha}" ] || continue
		case "$lsha" in *[!0]*) ;; *) continue ;; esac # delete line
		from="$rsha"
		case "$rsha" in
		*[!0]*) ;;
		*)
			# New remote ref: scan from its merge-base with dev.
			from=""
			for cand in origin/dev dev; do
				if git rev-parse --verify --quiet "$cand^{commit}" >/dev/null; then
					from=$(git merge-base "$lsha" "$cand")
					break
				fi
			done
			;;
		esac
		GITLEAKS_BIN="$GITLEAKS_BIN" bash scripts/gitleaks-scan.sh range "$from" "$lsha" || exit 1
	done <<<"$PUSH_LINES"
else
	GITLEAKS_BIN="$GITLEAKS_BIN" bash scripts/gitleaks-scan.sh worktree "${SCOPE_BASE:-dev}" || exit 1
fi
stage_end

# versions: drift guard against tools/versions.env (cheap, always).
stage_begin versions
bash scripts/check-versions.sh || exit 1
stage_end

# docs: no full SHAs on agent/* branches, only real reachable ones elsewhere.
if [ "$SCOPE_DOCS" = 1 ]; then
	stage_begin docs
	bash scripts/md-sha-check.sh || exit 1
	stage_end
fi

# shell: shellcheck on the gate scripts.
if [ "$SCOPE_SHELL" = 1 ]; then
	stage_begin shell
	command -v shellcheck >/dev/null 2>&1 ||
		block "shellcheck is not on PATH (install it: dnf/apt install ShellCheck / shellcheck)"
	shellcheck -x scripts/*.sh .githooks/pre-push || block "shellcheck found problems"
	echo "shellcheck: OK"
	stage_end
fi

# actions: actionlint on the workflows (and the deploy repo's reference
# workflow, deploy/deploy.yml).
if [ "$SCOPE_ACTIONS" = 1 ]; then
	stage_begin actions
	shopt -s nullglob
	WORKFLOWS=(.github/workflows/*.yml .github/workflows/*.yaml)
	shopt -u nullglob
	[ ! -f deploy/deploy.yml ] || WORKFLOWS+=(deploy/deploy.yml)
	if [ "${#WORKFLOWS[@]}" -eq 0 ]; then
		echo "actions: no workflows yet, skipped"
	else
		ACTIONLINT_BIN=$(tool_bin ACTIONLINT)
		"$ACTIONLINT_BIN" "${WORKFLOWS[@]}" || block "actionlint found problems"
		echo "actionlint: OK (${WORKFLOWS[*]})"
	fi
	stage_end
fi

# ---------------------------------------------------------------------------
# java / android: Gradle needs a full JDK (javac) >= JDK_VERSION. If
# JAVA_HOME is unset, use the JDK that provides `javac` on PATH (a distro's
# default `java` may be a headless JRE without a compiler).
# ---------------------------------------------------------------------------
android_sdk_present() {
	local d
	for d in "${ANDROID_HOME:-}" "${ANDROID_SDK_ROOT:-}"; do
		[ -n "$d" ] && [ -d "$d" ] && return 0
	done
	if [ -f local.properties ]; then
		d=$(sed -n 's/^sdk\.dir=//p' local.properties | head -n 1)
		[ -n "$d" ] && [ -d "$d" ] && return 0
	fi
	return 1
}
setup_jdk() {
	if [ -z "${JAVA_HOME:-}" ]; then
		local javac
		javac=$(command -v javac 2>/dev/null) || block "no JDK found: install a JDK >= $JDK_VERSION with javac, or set JAVA_HOME"
		JAVA_HOME=$(dirname "$(dirname "$(readlink -f "$javac")")")
		export JAVA_HOME
	fi
	[ -x "$JAVA_HOME/bin/javac" ] || block "JAVA_HOME=$JAVA_HOME has no bin/javac (a JRE, not a JDK)"
	local major
	# "javac 17.0.12" -> 17, "javac 27-ea" -> 27
	major=$("$JAVA_HOME/bin/javac" -version 2>&1 | awk '{ print $2 }' | cut -d. -f1)
	major="${major%%[!0-9]*}"
	[ "${major:-0}" -ge "$JDK_VERSION" ] 2>/dev/null ||
		block "JDK at $JAVA_HOME is version '$major'; JDK >= $JDK_VERSION is required"
	echo "JDK: $JAVA_HOME (javac $major; CI uses $JDK_VERSION)"
}

if [ "$SCOPE_JAVA" = 1 ] || [ "$SCOPE_ANDROID" = 1 ]; then
	setup_jdk
fi
if [ "$SCOPE_JAVA" = 1 ]; then
	stage_begin java
	GRADLE_ARGS=(:core:compileJava :desktop:compileJava test)
	if ! android_sdk_present; then
		echo "WARNING: no Android SDK (ANDROID_HOME / ANDROID_SDK_ROOT / local.properties sdk.dir):"
		echo "         Android unit tests are skipped locally (-x :android:test); CI runs them"
		GRADLE_ARGS+=(-x :android:test)
	fi
	./gradlew --console=plain "${GRADLE_ARGS[@]}" || block "gradle ${GRADLE_ARGS[*]} failed"
	stage_end
fi
if [ "$SCOPE_ANDROID" = 1 ]; then
	stage_begin android
	android_sdk_present ||
		block "android scope needs an Android SDK: set ANDROID_HOME or sdk.dir in local.properties"
	./gradlew --console=plain :android:assembleDebug || block "gradle :android:assembleDebug failed"
	stage_end
fi

# ---------------------------------------------------------------------------
# server: Go checks, pinned toolchain. No-op until server/go.mod exists.
# ---------------------------------------------------------------------------
if [ "$SCOPE_SERVER" = 1 ]; then
	stage_begin server
	if [ ! -f server/go.mod ]; then
		echo "server: server/go.mod does not exist yet, skipped"
	else
		export GOTOOLCHAIN="go${GO_VERSION}"
		echo "Go toolchain: GOTOOLCHAIN=$GOTOOLCHAIN ($(cd server && go version))"
		UNFORMATTED=$(gofmt -l server)
		[ -z "$UNFORMATTED" ] || block "gofmt found unformatted files:
$UNFORMATTED"
		(cd server && go vet ./...) || block "go vet failed"
		(cd server && go test ./...) || block "go test failed"
		GOVULNCHECK_BIN=$(tool_bin GOVULNCHECK)
		# Text mode: 0 = clean, 3 = vulnerabilities found, anything else = error.
		VULN_RC=0
		(cd server && "$GOVULNCHECK_BIN" ./...) || VULN_RC=$?
		case "$VULN_RC" in
		0) ;;
		3) block "govulncheck found vulnerabilities (bump the dependency, or GO_VERSION for stdlib findings)" ;;
		*) block "govulncheck failed (exit $VULN_RC)" ;;
		esac
	fi
	stage_end
fi

# ---------------------------------------------------------------------------
# docker: server image build + compose validation. No-op until the files
# exist (SRV-00).
# ---------------------------------------------------------------------------
if [ "$SCOPE_DOCKER" = 1 ]; then
	stage_begin docker
	if [ -f server/Dockerfile ]; then
		command -v docker >/dev/null 2>&1 || block "docker is required to build server/Dockerfile"
		docker build --build-arg VERSION=gate -t spd-coop-server:gate server/ || block "docker build of server/ failed"
	else
		echo "docker: server/Dockerfile does not exist yet, image build skipped"
	fi
	bash scripts/compose-validate.sh || exit 1
	stage_end
fi

# ---------------------------------------------------------------------------
# protocol: contract tests on the shared fixtures (docs/coop/protocol/
# fixtures, PROTOCOL.md §11). Both sides must pass the same files.
# ---------------------------------------------------------------------------
if [ "$SCOPE_PROTOCOL" = 1 ]; then
	stage_begin protocol
	[ -d docs/coop/protocol/fixtures ] || block "docs/coop/protocol/fixtures is missing"
	export GOTOOLCHAIN="go${GO_VERSION}"
	(cd server && go test -count=1 -v -run 'TestContract' ./internal/protocol/) >"$GATE_TMP/protocol-go.log" 2>&1 || {
		cat "$GATE_TMP/protocol-go.log"
		block "Go protocol contract tests failed"
	}
	grep -E 'contract fixtures exercised|^ok' "$GATE_TMP/protocol-go.log"
	# NET-01 hook: add the Java contract test here (same fixtures), e.g.
	#   ./gradlew --console=plain :core:test --tests '*ProtocolContract*' || block "Java protocol contract tests failed"
	# and remove the next line.
	echo "protocol: Java contract tests not wired yet (NET-01)"
	stage_end
fi

awk -v a="$GATE_T0" -v b="$EPOCHREALTIME" 'BEGIN { printf "[timing] total %.1fs\n", b - a }'
echo "== gate: all checks passed (scope: $SCOPE_KEY) =="

if [ -n "$STAMP_TREE" ]; then
	if [ "$(bash scripts/gate-stamp.sh tree)" = "$STAMP_TREE" ]; then
		bash scripts/gate-stamp.sh write "$STAMP_TREE" "$SCOPE_KEY"
	else
		echo "WARNING: files changed while the gate ran; no stamp written. Run make check again before make commit."
	fi
fi
